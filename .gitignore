# 秘密情報（APIキーなど）。見本の .env.example だけは入れる
.env
.env.*
!.env.example

# 本物の見本データ（実名を含む）は、形式に関係なくフォルダごと入れない
/samples/

# 実データの保険：Excel・CSVは入れない（開発用の架空データは fixtures\ の中だけ許可）
*.xlsx
*.xls
*.xlsm
*.csv
!fixtures/**/*.csv
~$*

# 通話録音・個人情報が入りやすい文書は入れない（必要なものは確認して例外を足す）
*.mp3
*.wav
*.m4a
*.aac
*.wma
*.pdf
*.docx
*.doc
*.zip

# 開発で自動生成されるもの
node_modules/
dist/
build/
.firebase/
*.log

# 個人ごとの設定
.claude/settings.local.json

# Windows・Macが自動で作るファイル
Thumbs.db
desktop.ini
.DS_Store
